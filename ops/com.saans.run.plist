<?xml version="1.0" encoding="UTF-8"?>
<!--
  OPTIONAL daily schedule for `saans run` (DECISIONS.md D-003: manual runs for now).
  NOT installed by default. To install, replace __REPO__ with the absolute repo path:

    sed "s#__REPO__#$PWD#g" ops/com.saans.run.plist > ~/Library/LaunchAgents/com.saans.run.plist
    launchctl load ~/Library/LaunchAgents/com.saans.run.plist

  Remove:  launchctl unload ~/Library/LaunchAgents/com.saans.run.plist && rm ~/Library/LaunchAgents/com.saans.run.plist
  Note: launchd does not run while the Mac sleeps; a missed 06:00 run fires once on wake.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.saans.run</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/saans</string>
    <string>--config</string>
    <string>__REPO__/config.yaml</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/data/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/launchd.log</string>
</dict>
</plist>
